# Copy to .env and fill in. NEVER commit .env. Real environment variables win over .env (override=False).
# Only presence is ever reported (python scripts/check_env.py); a value is never printed or logged.

# OpenRouter: agent backbones and the judge. Live calls are refused before the kickoff (2026-11-06 20:00 UTC).
OPENROUTER_API_KEY=

# Weights & Biases. Offline runs need no key; `online` mode (after kickoff) does.
WANDB_API_KEY=

# Hugging Face: optional, the pinned datasets are public.
HF_TOKEN=
# Rerun from the local dataset cache (set 1 only after the cache is filled).
# HF_HUB_OFFLINE=1
# HF_DATASETS_OFFLINE=1

# Override the kickoff guard time if the official start differs (UTC, ISO format).
# SWARMLAB_KICKOFF_UTC=2026-11-06T20:00:00+00:00
